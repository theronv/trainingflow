{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run format:check)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(node scripts/check-tokens.mjs*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/stop-check.sh" }
        ]
      }
    ]
  }
}
