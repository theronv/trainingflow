{
  "name": "pregame-academy",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend tooling (lint, formatting, checks). The app itself has no build step.",
  "scripts": {
    "lint": "eslint . && node scripts/check-tokens.mjs",
    "format": "prettier --write",
    "format:check": "prettier --check js css index.html"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.67.0",
    "@html-eslint/parser": "^0.67.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
